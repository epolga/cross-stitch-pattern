option_settings:
  aws:elasticbeanstalk:environment:process:default:
    Port: 8080
    HealthCheckPath: /
  aws:elasticbeanstalk:command:
    Timeout: 1800
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: 8080

files:
  "/etc/nginx/conf.d/proxy.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      upstream nodejs {
        server 127.0.0.1:8080;
        keepalive 256;
      }
      server {
        listen 80;
        location / {
          proxy_pass http://nodejs;
          proxy_set_header Connection "";
          proxy_http_version 1.1;
          proxy_set_header Host $host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
      }
  "/etc/nginx/conf.d/custom.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      http {
        types_hash_max_size 2048;
        types_hash_bucket_size 128;
      }

commands:
  01_clear_npm_cache:
    command: |
      npm cache clean --force
    ignoreErrors: true
  02_ensure_node_version:
    command: |
      NODE_VERSION=$(node -v)
      if [[ ! $NODE_VERSION =~ ^v20\. ]]; then
        echo "Installing Node.js 20.19.0"
        curl -fsSL https://rpm.nodesource.com/setup_20.x | bash -
        yum install -y nodejs
      fi
    ignoreErrors: false
  03_install_dependencies:
    command: |
      npm install --no-optional --production --loglevel=verbose || npm install --no-optional --production --loglevel=verbose
    ignoreErrors: false
  04_build_app:
    command: |
      npm run build
    ignoreErrors: false

container_commands:
  01_start_app:
    command: |
      npm run start
    leader_only: false
  02_reload_nginx:
    command: |
      systemctl restart nginx
    leader_only: false