option_settings:
  aws:elasticbeanstalk:container:nodejs:
    NodeVersion: 18.17.0
  aws:elasticbeanstalk:environment:process:default:
    Port: 8080
    HealthCheckPath: /
  aws:elasticbeanstalk:command:
    Timeout: 1800

commands:
  01_install_node:
    command: |
      # Ensure Node.js 18.17.0 is installed
      /opt/elasticbeanstalk/bin/get-config container -o > /tmp/container.json
      NODE_VER=$(jq -r '.node_version' /tmp/container.json)
      if [ "$NODE_VER" != "18.17.0" ]; then
        echo "Installing Node.js 18.17.0"
        curl -fsSL https://rpm.nodesource.com/setup_18.x | bash -
        yum install -y nodejs
      fi
  02_install_dependencies:
    command: |
      # Install dependencies
      npm install
  03_build_app:
    command: |
      # Build the Next.js app
      npm run build

container_commands:
  01_start_app:
    command: |
      # Start the Next.js app
      npm run start