option_settings:
  aws:elasticbeanstalk:environment:process:default:
    Port: 8080
    HealthCheckPath: /
  aws:elasticbeanstalk:command:
    Timeout: 1800
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: 8080

files:
  "/etc/nginx/conf.d/proxy.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      upstream nodejs {
        server 127.0.0.1:8080;
        keepalive 256;
      }
      server {
        listen 80;
        location / {
          proxy_pass http://nodejs;
          proxy_set_header Connection "";
          proxy_http_version 1.1;
          proxy_set_header Host $host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
      }
  "/etc/nginx/conf.d/custom.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      http {
        types_hash_max_size 2048;
        types_hash_bucket_size 128;
      }
  "/etc/cfn/logoptions.cfg":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/npm-install.log
      /var/log/npm-build.log
      /var/log/npm-start.log
  "/var/log/npm-install.log":
    mode: "000666"
    owner: webapp
    group: webapp
    content: ""
  "/var/log/npm-build.log":
    mode: "000666"
    owner: webapp
    group: webapp
    content: ""
  "/var/log/npm-start.log":
    mode: "000666"
    owner: webapp
    group: webapp
    content: ""

commands:
  01_clear_npm_cache:
    command: |
      npm cache clean --force
      rm -rf /root/.npm
      rm -rf /home/webapp/.npm
      mkdir -p /home/webapp/.npm
      chown webapp:webapp /home/webapp/.npm
    ignoreErrors: true
  02_verify_node_version:
    command: |
      echo "Checking Node.js version..." > /var/log/npm-install.log
      node -v >> /var/log/npm-install.log
      npm -v >> /var/log/npm-install.log
      if [[ ! $(node -v) =~ ^v20\. ]]; then
        echo "ERROR: Node.js version is not 20.x, found $(node -v)" >> /var/log/npm-install.log
        exit 1
      else
        echo "Node.js 20 confirmed" >> /var/log/npm-install.log
      fi
    ignoreErrors: false

container_commands:
  01_set_permissions:
    command: |
      chown -R webapp:webapp /var/app/staging
      chmod -R u+rw /var/app/staging
    ignoreErrors: false
  02_install_dependencies:
    command: |
      cd /var/app/staging
      su webapp -c "npm install --no-optional --production --loglevel=verbose >> /var/log/npm-install.log 2>&1"
    ignoreErrors: false
  03_build_app:
    command: |
      cd /var/app/staging
      su webapp -c "npm run build >> /var/log/npm-build.log 2>&1"
    ignoreErrors: false
  04_start_app:
    command: |
      cd /var/app/staging
      su webapp -c "npm run start >> /var/log/npm-start.log 2>&1"
    leader_only: false
  05_reload_nginx:
    command: |
      systemctl restart nginx
    leader_only: false